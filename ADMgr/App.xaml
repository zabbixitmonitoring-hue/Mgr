        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary   Source="pack://application:,,,/ErmilovStyle;component/Themes/Core.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PrimaryMidBrush" Color="#FF13344B"  />
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FF1D4057"  />
            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF0D2738"  />

            <LinearGradientBrush x:Key="3BrushTrackProgressBar2" EndPoint="0,0.5" StartPoint="1,0.5">
                <GradientStop Color="#FFEFCF38" Offset="1"/>
