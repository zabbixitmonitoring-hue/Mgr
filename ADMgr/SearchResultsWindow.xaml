<Window x:Class="ADMgr.SearchResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ADMgr"
        Title="Результаты поиска" SizeToContent="WidthAndHeight" ResizeMode="NoResize" 
		WindowStartupLocation="CenterOwner"
        MaxWidth="620" MaxHeight="620" 
        ShowInTaskbar="False"        
        Style="{StaticResource VS2012WindowStyle}" Icon="/hiring.ico">
    <Window.Resources>
        <local:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter" />
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox x:Name="lbResults" Width="520" Height="440" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Padding="4">
                            <Grid>
                                <Image Width="72" Height="72" Source="{Binding PhotoBytes, Converter={StaticResource ByteArrayToImageConverter}}" Visibility="Collapsed" Stretch="Uniform"/>
                            <!-- Rounded rectangle filled with the image via ImageBrush to get proper rounded corners -->
                                <Rectangle Height="72" Width="72" RadiusX="48" RadiusY="48" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Stroke="#FF4A90E2" StrokeThickness="2">
                                <Rectangle.Fill>
                                        <ImageBrush ImageSource="{Binding PhotoBytes, Converter={StaticResource ByteArrayToImageConverter}}" Stretch="UniformToFill" />
                                </Rectangle.Fill>
                                <Rectangle.Effect>
                                    <DropShadowEffect Color="#66000000" BlurRadius="8" ShadowDepth="2" Opacity="0.8" />
                                </Rectangle.Effect>
                            </Rectangle>
                    </Grid>
                    </Border>
                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Department, StringFormat=Отдел: {0}}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding TelephoneNumber, StringFormat=Телефон: {0}}" />
                            <TextBlock Text="{Binding UserPrincipalName, StringFormat=UPN: {0}}" />
                            <TextBlock Text="{Binding Description, StringFormat=Описание: {0}}" TextWrapping="Wrap" MaxWidth="480" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="bnOk" Content="Выбрать" Width="90" Margin="4" IsDefault="True" />
            <Button x:Name="bnCancel" Content="Отмена" Width="90" Margin="4" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
