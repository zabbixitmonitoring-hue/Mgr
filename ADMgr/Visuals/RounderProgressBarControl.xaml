<UserControl x:Class="RounderProgressBar.RounderProgressBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="50" Width="50">
    <UserControl.Resources>

        <Style x:Key="canvasStyle" TargetType="{x:Type Canvas}">
            <Setter Property="Background" Value="Transparent"/>
            <!--<Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>-->
        </Style>

        <Style x:Key ="rectangle" TargetType="{x:Type Rectangle}">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="LightBlue"/>
            <Setter Property="Canvas.Left" Value="21"/>
            <Setter Property="Canvas.Top" Value="0"/>
            <Setter Property="RadiusX" Value="1"/>
            <Setter Property="RadiusY" Value="1"/>
        </Style>

        <Style x:Key="percents" TargetType="{x:Type TextBox}">
            <Setter Property="FontSize" Value="4" />
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="IsReadOnly" Value="true"/>
        </Style>

    </UserControl.Resources>
    <Canvas RenderTransformOrigin="0.5,0.5" Style="{StaticResource canvasStyle}">
        <TextBox Name="tbPercents" Style="{StaticResource percents}"  Canvas.Left="12.334" Canvas.Top="18.73" 
                 TextChanged="tblPercents_TextChanged" Background="{x:Null}" Foreground="#FF14C5FF" Width="20.724" Height="5.6" BorderBrush="{x:Null}">
            <TextBox.Effect>
                <DropShadowEffect BlurRadius="1" ShadowDepth="0" Direction="1"/>
            </TextBox.Effect>
            
        </TextBox>
        <Canvas Name="rotationCanvas" RenderTransformOrigin="0.5,0.5" Style="{StaticResource canvasStyle}">
            <Canvas.Effect>
                <DropShadowEffect BlurRadius="2" ShadowDepth="0" Direction="1"/>
            </Canvas.Effect>
            <Rectangle  Style="{StaticResource rectangle}" Fill="#FF00C0FF"/>
            <Rectangle Opacity="0.92" Style="{StaticResource rectangle}" Fill="#FF14C5FF">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="30" CenterX="1" CenterY="22"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Opacity="0.84" Style="{StaticResource rectangle}" Fill="#FF28CDFF">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="60" CenterX="1" CenterY="22"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Opacity="0.76" Style="{StaticResource rectangle}" Fill="#FF3CD0FF" >
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="90" CenterX="1" CenterY="22"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Opacity="0.66" Style="{StaticResource rectangle}" Fill="#FF50D8FF">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="120" CenterX="1" CenterY="22"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Opacity="0.58" Style="{StaticResource rectangle}" Fill="#FF64DBFF" >
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="150" CenterX="1" CenterY="22"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Opacity="0.5" Style="{StaticResource rectangle}" Fill="#FF78D8E6" >
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="180" CenterX="1" CenterY="22"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Opacity="0.42" Style="{StaticResource rectangle}" Fill="#FF8CD8E6" >
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="210" CenterX="1" CenterY="22"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Opacity="0.34" Style="{StaticResource rectangle}" Fill="#FFA0D8E6" >
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="240" CenterX="1" CenterY="22"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Opacity="0.26" Style="{StaticResource rectangle}" Fill="#FFB4D8E6" >
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="270" CenterX="1" CenterY="22"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Opacity="0.16" Style="{StaticResource rectangle}" Fill="#FFC8D8E6" >
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="300" CenterX="1" CenterY="22"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Opacity="0.08" Style="{StaticResource rectangle}" >
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="330" CenterX="1" CenterY="22"/>
                </Rectangle.RenderTransform>
            </Rectangle>
            <Canvas.RenderTransform>
                <RotateTransform x:Name="SpinnerRotate"  Angle="0" CenterX="22" CenterY="22" />
            </Canvas.RenderTransform>
        </Canvas>
    </Canvas>
</UserControl>
